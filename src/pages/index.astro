---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HackerNewsSection from '../components/HackerNewsSection.astro';
import YCSection from '../components/YCSection.astro';
import GitHubSection from '../components/GitHubSection.astro';
import ArxivSection from '../components/ArxivSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />
  <main>
    <HackerNewsSection />
    <YCSection />
    <GitHubSection />
    <ArxivSection />
  </main>
  <Footer />
</Layout>

<style>
  main {
    min-height: 60vh;
  }

  /* Smooth scroll-margin for anchored sections */
  :global(section[id]) {
    scroll-margin-top: 2rem;
  }

  /* Staggered entrance animations */
  :global(.feed-section) {
    animation: fadeInUp 0.5s ease-out both;
  }

  :global(.feed-section:nth-child(1)) { animation-delay: 0.1s; }
  :global(.feed-section:nth-child(2)) { animation-delay: 0.2s; }
  :global(.feed-section:nth-child(3)) { animation-delay: 0.3s; }
  :global(.feed-section:nth-child(4)) { animation-delay: 0.4s; }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
